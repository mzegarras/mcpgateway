{
  "annotations": { "list": [] },
  "editable": true,
  "title": "agentgateway audit",
  "uid": "agentgateway-audit",
  "tags": ["agentgateway", "audit", "mcp"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Decisiones por reason (rate 5m)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (count_over_time({service_name=\"agentgateway\"} [5m]))", "legendFormat": "{{reason}}", "datasource": { "type": "loki", "uid": "loki" } }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Audit log (agentgateway)",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"agentgateway\"}", "datasource": { "type": "loki", "uid": "loki" } }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
